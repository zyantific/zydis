       EASZ: 64
   CATEGORY: CONVERT
    ISA-SET: AVX512_FP8_CONVERT_512
    ISA-EXT: AVX512EVEX
 EXCEPTIONS: E4NF
 ATTRIBUTES: HAS_MODRM HAS_EVEX ACCEPTS_SEGMENT 
  OPTIMIZED: 62 52 54 50 74 61 10 

