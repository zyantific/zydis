     LENGTH: 10
        SSZ: 64
       EOSZ: 16
       EASZ: 64
   CATEGORY: CET
    ISA-SET: APX_F_CET
    ISA-EXT: APXEVEX
 EXCEPTIONS: APX_EVEX_CET_WRUSS
 ATTRIBUTES: HAS_MODRM HAS_EVEX IS_PRIVILEGED ACCEPTS_SEGMENT HAS_EEVEX 
  OPTIMIZED: 62 EC 7D 08 65 91 78 56 34 12 

