== [    BASIC ] ============================================================================================
   MNEMONIC: vunpackb [ENC: EVEX, MAP: 0F3A, OPC: 0x3D]
     LENGTH:  8
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: AVX512
    ISA-SET: AVX10_V2_AUX_512
    ISA-EXT: AVX512EVEX
 EXCEPTIONS: E4NF
 ATTRIBUTES: HAS_MODRM HAS_EVEX ACCEPTS_SEGMENT 
  OPTIMIZED: 62 53 7C 4B 3D 68 01 07 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0   REGISTER    EXPLICIT     RCW     MODRM_REG    512     64       8      UINT                        zmm13
 1   REGISTER    EXPLICIT       R          MASK     64     64       1       INT                           k3
 2     MEMORY    EXPLICIT       R      MODRM_RM    512     64       8      UINT  TYPE  =                 MEM
                                                                                 SEG   =                  ds
                                                                                 BASE  =                  r8
                                                                                 INDEX =                none
                                                                                 SCALE =                   0
                                                                                 DISP  =  0x0000000000000040
 3  IMMEDIATE    EXPLICIT       R         UIMM8      8      1       8      UINT  [U A  8] 0x0000000000000007
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------

== [      AVX ] ============================================================================================
  VECTORLEN: 512
  BROADCAST: NONE
   ROUNDING: NONE
        SAE: N
       MASK: k3 [MERGING]

== [      ATT ] ============================================================================================
   ABSOLUTE: vunpackbz $0x07, 0x40(%r8), %zmm13 {%k3}
   RELATIVE: vunpackbz $0x07, 0x40(%r8), %zmm13 {%k3}

== [    INTEL ] ============================================================================================
   ABSOLUTE: vunpackb zmm13 {k3}, zmmword ptr ds:[r8+0x40], 0x07
   RELATIVE: vunpackb zmm13 {k3}, zmmword ptr ds:[r8+0x40], 0x07

== [ SEGMENTS ] ============================================================================================
62 53 7C 4B 3D 68 01 07 
:           :  :  :  :..IMM
:           :  :  :..DISP
:           :  :..MODRM
:           :..OPCODE
:..EVEX
