== [    BASIC ] ============================================================================================
   MNEMONIC: cmpbexadd [ENC: VEX, MAP: 0F38, OPC: 0xE6]
     LENGTH:  6
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: VEX
    ISA-SET: CMPCCXADD
    ISA-EXT: CMPCCXADD
 EXCEPTIONS: AVX14
 ATTRIBUTES: HAS_MODRM HAS_SIB HAS_VEX CPUFLAG_ACCESS ACCEPTS_SEGMENT 
  OPTIMIZED: C4 E2 79 E6 04 01 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0     MEMORY    EXPLICIT      RW      MODRM_RM     32      1      32      UINT  TYPE  =                 MEM
                                                                                 SEG   =                  ds
                                                                                 BASE  =                 rcx
                                                                                 INDEX =                 rax
                                                                                 SCALE =                   1
                                                                                 DISP  =  0x0000000000000000
 1   REGISTER    EXPLICIT      RW     MODRM_REG     32      1      32      UINT                          eax
 2   REGISTER    EXPLICIT       R        NDSNDD     32      1      32      UINT                          eax
 3   REGISTER      HIDDEN       W          NONE     64     64       1       INT                       rflags
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------

== [    FLAGS ] ============================================================================================
    ACTIONS: [CF  : M  ] [PF  : M  ] [AF  : M  ] [ZF  : M  ] [SF  : M  ] [OF  : M  ] 
       READ: 0x00000000
    WRITTEN: 0x000008D5

== [      AVX ] ============================================================================================
  VECTORLEN: 128
  BROADCAST: NONE

== [      ATT ] ============================================================================================
   ABSOLUTE: cmpbexadd %eax, %eax, (%rcx,%rax,1)
   RELATIVE: cmpbexadd %eax, %eax, (%rcx,%rax,1)

== [    INTEL ] ============================================================================================
   ABSOLUTE: cmpbexadd dword ptr ds:[rcx+rax*1], eax, eax
   RELATIVE: cmpbexadd dword ptr ds:[rcx+rax*1], eax, eax

