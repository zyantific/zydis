== [    BASIC ] ============================================================================================
   MNEMONIC: vunpackb [ENC: EVEX, MAP: 0F3A, OPC: 0x3D]
     LENGTH:  8
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: AVX512
    ISA-SET: AVX10_V2_AUX_128
    ISA-EXT: AVX512EVEX
 EXCEPTIONS: E4NF
 ATTRIBUTES: HAS_MODRM HAS_EVEX ACCEPTS_SEGMENT 
  OPTIMIZED: 62 53 7C 0B 3D 68 01 07 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0   REGISTER    EXPLICIT     RCW     MODRM_REG    128     16       8      UINT                        xmm13
 1   REGISTER    EXPLICIT       R          MASK     64     64       1       INT                           k3
 2     MEMORY    EXPLICIT       R      MODRM_RM    128     16       8      UINT  TYPE  =                 MEM
                                                                                 SEG   =                  ds
                                                                                 BASE  =                  r8
                                                                                 INDEX =                none
                                                                                 SCALE =                   0
                                                                                 DISP  =  0x0000000000000010
 3  IMMEDIATE    EXPLICIT       R         UIMM8      8      1       8      UINT  [U A  8] 0x0000000000000007
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------

== [      AVX ] ============================================================================================
  VECTORLEN: 128
  BROADCAST: NONE
   ROUNDING: NONE
        SAE: N
       MASK: k3 [MERGING]

== [      ATT ] ============================================================================================
   ABSOLUTE: vunpackbx $0x07, 0x10(%r8), %xmm13 {%k3}
   RELATIVE: vunpackbx $0x07, 0x10(%r8), %xmm13 {%k3}

== [    INTEL ] ============================================================================================
   ABSOLUTE: vunpackb xmm13 {k3}, xmmword ptr ds:[r8+0x10], 0x07
   RELATIVE: vunpackb xmm13 {k3}, xmmword ptr ds:[r8+0x10], 0x07

== [ SEGMENTS ] ============================================================================================
62 53 7C 0B 3D 68 01 07 
:           :  :  :  :..IMM
:           :  :  :..DISP
:           :  :..MODRM
:           :..OPCODE
:..EVEX
