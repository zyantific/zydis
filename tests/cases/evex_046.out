== [    BASIC ] ============================================================================================
   MNEMONIC: vaesenc [ENC: EVEX, MAP: 0F38, OPC: 0xDC]
     LENGTH:  7
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: VAES
    ISA-SET: AVX512_VAES_512
    ISA-EXT: AVX512EVEX
 EXCEPTIONS: E4
 ATTRIBUTES: HAS_MODRM HAS_EVEX ACCEPTS_SEGMENT 
  OPTIMIZED: 62 F2 6D 48 DC 48 10 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0   REGISTER    EXPLICIT       W     MODRM_REG    512      4     128      UINT                         zmm1
 1   REGISTER    EXPLICIT       R        NDSNDD    512      4     128      UINT                         zmm2
 2     MEMORY    EXPLICIT       R      MODRM_RM    512      4     128      UINT  TYPE  =                 MEM
                                                                                 SEG   =                  ds
                                                                                 BASE  =                 rax
                                                                                 INDEX =                none
                                                                                 SCALE =                   0
                                                                                 DISP  =  0x0000000000000400
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------

== [      AVX ] ============================================================================================
  VECTORLEN: 512
  BROADCAST: NONE
   ROUNDING: NONE
        SAE: N
       MASK: k0 [DISABLED]

== [      ATT ] ============================================================================================
   ABSOLUTE: vaesenc 0x400(%rax), %zmm2, %zmm1
   RELATIVE: vaesenc 0x400(%rax), %zmm2, %zmm1

== [    INTEL ] ============================================================================================
   ABSOLUTE: vaesenc zmm1, zmm2, zmmword ptr ds:[rax+0x400]
   RELATIVE: vaesenc zmm1, zmm2, zmmword ptr ds:[rax+0x400]

== [ SEGMENTS ] ============================================================================================
62 F2 6D 48 DC 48 10 
:           :  :  :..DISP
:           :  :..MODRM
:           :..OPCODE
:..EVEX
