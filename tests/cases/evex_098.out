 0   REGISTER    EXPLICIT       W     MODRM_REG    512     32      16   FLOAT16                        zmm23
 1   REGISTER    EXPLICIT       R      MODRM_RM   8192    256      32   FLOAT32                         tmm1
 2   REGISTER    EXPLICIT       R        NDSNDD     32      1      32      UINT                         r12d
