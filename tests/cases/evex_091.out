== [    BASIC ] ============================================================================================
   MNEMONIC: tileloaddt1 [ENC: EVEX, MAP: 0F38, OPC: 0x4B]
     LENGTH:  7
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: AMX_TILE
    ISA-SET: APX_F_AMX
    ISA-EXT: APXEVEX
 EXCEPTIONS: AMXE3_EVEX
 ATTRIBUTES: HAS_MODRM HAS_SIB HAS_EVEX ACCEPTS_SEGMENT HAS_EEVEX 
  OPTIMIZED: 62 F2 7D 08 4B 0C 08 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0   REGISTER    EXPLICIT       W     MODRM_REG   8192    256      32      UINT                         tmm1
 1     MEMORY    EXPLICIT       R      MODRM_RM      0      1      32      UINT  TYPE  =                 MEM
                                                                                 SEG   =                  ds
                                                                                 BASE  =                 rax
                                                                                 INDEX =                 rcx
                                                                                 SCALE =                   1
                                                                                 DISP  =  0x0000000000000000
