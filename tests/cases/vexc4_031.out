== [    BASIC ] ============================================================================================
   MNEMONIC: vpshufb [ENC: VEX, MAP: 0F38, OPC: 0x00]
     LENGTH:  6
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: AVX
    ISA-SET: AVX
    ISA-EXT: AVX
 EXCEPTIONS: AVX4
 ATTRIBUTES: HAS_MODRM HAS_SIB HAS_VEX ACCEPTS_SEGMENT 
  OPTIMIZED: C4 E2 71 00 04 08 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0   REGISTER    EXPLICIT       W     MODRM_REG    128     16       8      UINT                         xmm0
 1   REGISTER    EXPLICIT       R        NDSNDD    128     16       8      UINT                         xmm1
 2     MEMORY    EXPLICIT       R      MODRM_RM    128     16       8      UINT  TYPE  =                 MEM
                                                                                 SEG   =                  ds
                                                                                 BASE  =                 rax
                                                                                 INDEX =                 rcx
                                                                                 SCALE =                   1
                                                                                 DISP  =  0x0000000000000000
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------

== [      AVX ] ============================================================================================
  VECTORLEN: 128
  BROADCAST: NONE

== [      ATT ] ============================================================================================
   ABSOLUTE: vpshufb (%rax,%rcx,1), %xmm1, %xmm0
   RELATIVE: vpshufb (%rax,%rcx,1), %xmm1, %xmm0

== [    INTEL ] ============================================================================================
   ABSOLUTE: vpshufb xmm0, xmm1, xmmword ptr ds:[rax+rcx*1]
   RELATIVE: vpshufb xmm0, xmm1, xmmword ptr ds:[rax+rcx*1]

== [ SEGMENTS ] ============================================================================================
C4 E2 71 00 04 08 
:        :  :  :..SIB
:        :  :..MODRM
:        :..OPCODE
:..VEX
