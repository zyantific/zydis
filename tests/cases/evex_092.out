== [    BASIC ] ============================================================================================
   MNEMONIC: tcvtrowd2ps [ENC: EVEX, MAP: 0F38, OPC: 0x4A]
     LENGTH:  6
        SSZ: 64
       EOSZ: 32
       EASZ: 64
   CATEGORY: AMX_TILE
    ISA-SET: AMX_AVX512
    ISA-EXT: AMX_TILE
 EXCEPTIONS: AMXE8_EVEX
 ATTRIBUTES: HAS_MODRM HAS_EVEX 
  OPTIMIZED: 62 E2 36 48 4A CB 

== [ OPERANDS ] ============================================================================================
##       TYPE  VISIBILITY  ACTION      ENCODING   SIZE  NELEM  ELEMSZ  ELEMTYPE                        VALUE
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------
 0   REGISTER    EXPLICIT       W     MODRM_REG    512     16      32   FLOAT32                        zmm17
 1   REGISTER    EXPLICIT       R      MODRM_RM   8192    256      32       INT                         tmm3
 2   REGISTER    EXPLICIT       R        NDSNDD     32      1      32      UINT                          r9d
--  ---------  ----------  ------  ------------   ----  -----  ------  --------  ---------------------------

== [      AVX ] ============================================================================================
  VECTORLEN: 512
  BROADCAST: NONE
   ROUNDING: NONE
        SAE: N
       MASK: k0 [DISABLED]

== [      ATT ] ============================================================================================
   ABSOLUTE: tcvtrowd2ps %r9d, %tmm3, %zmm17
   RELATIVE: tcvtrowd2ps %r9d, %tmm3, %zmm17

== [    INTEL ] ============================================================================================
   ABSOLUTE: tcvtrowd2ps zmm17, tmm3, r9d
   RELATIVE: tcvtrowd2ps zmm17, tmm3, r9d

== [ SEGMENTS ] ============================================================================================
62 E2 36 48 4A CB 
:           :  :..MODRM
:           :..OPCODE
:..EVEX
